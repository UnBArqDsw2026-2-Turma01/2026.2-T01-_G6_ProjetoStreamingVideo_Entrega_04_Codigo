{
  "$schema": "https://typedoc.org/schema.json",
  "name": "@g6/shared-kernel",
  "entryPoints": [
    "../../packages/shared-kernel/src/index.ts",
    "../../packages/shared-kernel/src/testing/index.ts"
  ],
  "tsconfig": "../../packages/shared-kernel/tsconfig.json",
  "out": "../../packages/shared-kernel/docs/api",
  "plugin": [
    "typedoc-plugin-markdown"
  ],
  "readme": "none",
  "excludePrivate": true,
  "excludeInternal": true,
  "disableSources": true,
  "hidePageHeader": true,
  "hideBreadcrumbs": true,
  "githubPages": false,
  "outputFileStrategy": "modules",
  "gitRevision": "main",
  "intentionallyNotExported": [
    "RegistroRecarga"
  ],
  "treatWarningsAsErrors": true
}

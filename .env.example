# Copie para .env (ignorado pelo git) só se for usar os processadores reais.
# Vale para `npm run web` e para `docker compose up`: o Compose lê o .env ao subir o
# contêiner, sem copiá-lo para a imagem. Sem estas variáveis, só o gateway simulado.
# Apenas credenciais de TESTE: credencial de produção é recusada ao iniciar.

NODE_ENV=development
PORT=3000

# Gateways reais (modo teste) — nunca embutir na imagem
# MERCADO_PAGO_ACCESS_TOKEN=       # TEST-... ou APP_USR-... do vendedor de teste
# MERCADO_PAGO_WEBHOOK_SECRET=     # opcional
# STRIPE_SECRET_KEY=               # sk_test_...
# STRIPE_WEBHOOK_SECRET=           # opcional
